# Mutinynet (test funds only). Read-only check: node --env-file=.env.mutinynet.example --import tsx scripts/preflight.ts
# Endpoints default to Arkade's published Mutinynet hosts (Esplora from the SDK); the operator key is read from
# the Ark server and the emulator key is the SDK's Mutinynet pin. Set ARK_SERVER_URL / EMULATOR_URL / ESPLORA_URL
# or ARK_SIGNER_PUBKEY / EMULATOR_PUBKEY only to override. A key change on an existing volume stops the server.
APM_NETWORK=mutinynet
APM_DEPLOYMENT_ID=apm-mutinynet-1
PUBLIC_BASE_URL=https://prediction.example.org
EXPLORER_URL=https://explorer.mutinynet.arkade.sh
OPERATOR_MNEMONIC_FILE=/run/secrets/operator_mnemonic
LP_MNEMONIC_FILE=/run/secrets/lp_mnemonic
ADMIN_TOKEN_FILE=/run/secrets/admin_token
ORACLE_SECRET_KEY_FILE=/run/secrets/oracle_secret_key
ORACLE_PUBKEYS=<x-only pubkey of each attestor, comma-separated>
ORACLE_THRESHOLD=1
POLYMARKET_ENABLED=true
POLYGON_RPC_URLS=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org
POLYMARKET_RESOLVERS=0x65070BE91477460D8A7AeEb94ef92fe056C2f2A7,0x157Ce2d672854c848c9b79C49a8Cc6cc89176a49
IMPORT_MAX_ACTIVE=3
DEV_ENDPOINTS=false
