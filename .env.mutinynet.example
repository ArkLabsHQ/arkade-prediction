# Mutinynet starter (test funds only). Read-only check first:
#   node --env-file=.env.mutinynet.example --import tsx scripts/preflight.ts
# Endpoints default to Arkade's published Mutinynet hosts (Esplora from the SDK), the operator key is read from the
# Ark server and the emulator key is the SDK's Mutinynet pin. Secrets work as plain variables or as NAME_FILE.

# ---- app ----------------------------------------------------------------------------------------------------
APM_NETWORK=mutinynet
OPERATOR_MNEMONIC=<12 words: pays genesis of imported markets>
LP_MNEMONIC=<12 words, different: posts starting liquidity>
ADMIN_TOKEN=<48 hex chars>
ORACLE_URLS=http://<attestor app name>:37410
ORACLE_PUBKEYS=<attestor x-only pubkey>
ORACLE_THRESHOLD=1
POLYMARKET_ENABLED=true
POLYGON_RPC_URLS=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org
POLYMARKET_RESOLVERS=0x65070BE91477460D8A7AeEb94ef92fe056C2f2A7,0x157Ce2d672854c848c9b79C49a8Cc6cc89176a49
IMPORT_MAX_ACTIVE=2
MARKET_UNIT_SATS=1000
MARKET_CAP_SETS=100
LP_BOOTSTRAP_SETS=5
LP_ASK_YES_SATS=550
LP_ASK_NO_SATS=550
EXPLORER_URL=https://explorer.mutinynet.arkade.sh

# ---- attestor (separate Application, command: node dist/oracle/main.js) --------------------------------------
# APM_NETWORK=mutinynet
# ORACLE_SECRET_KEY=<64 hex chars>
# ORACLE_PORT=37410
# POLYGON_RPC_URLS=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org
# POLYMARKET_RESOLVERS=0x65070BE91477460D8A7AeEb94ef92fe056C2f2A7,0x157Ce2d672854c848c9b79C49a8Cc6cc89176a49
