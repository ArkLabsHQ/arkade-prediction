# Mutinynet single container (test funds only): UI/API on 37400, unauthenticated operator console/API on 37401
# (protect it at your edge), local 1-of-1 attestor started because ORACLE_SECRET_KEY is set.
# Endpoints, operator/emulator keys, attestor URL and key all default. Read-only check first:
#   node --env-file=.env.mutinynet.example --import tsx scripts/preflight.ts
APM_NETWORK=mutinynet
OPERATOR_MNEMONIC=<12 words: pays genesis of imported markets>
LP_MNEMONIC=<12 different words: posts starting liquidity>
ORACLE_SECRET_KEY=<64 hex chars>
POLYMARKET_ENABLED=true
POLYGON_RPC_URLS=https://polygon.drpc.org,https://polygon.gateway.tenderly.co,https://polygon-bor-rpc.publicnode.com,https://1rpc.io/matic
# The last entry is Polymarket's NegRiskAdapter: it admits single outcomes of multi-outcome events.
POLYMARKET_RESOLVERS=0x65070BE91477460D8A7AeEb94ef92fe056C2f2A7,0x157Ce2d672854c848c9b79C49a8Cc6cc89176a49,0xd91E80cF2E7be2e162c6513ceD06f1dD0dA35296
IMPORT_MAX_ACTIVE=12
IMPORT_MAX_HORIZON_SECONDS=7776000
MARKET_UNIT_SATS=1000
MARKET_CAP_SETS=100
LP_BOOTSTRAP_SETS=2
LP_ASK_YES_SATS=550
LP_ASK_NO_SATS=550
EXPLORER_URL=https://explorer.mutinynet.arkade.sh
# Polymarket crypto Up/Down mirrors settled in-covenant on RedStone's signed rounds (no attestor, no API key).
UPDOWN_ENABLED=true
UPDOWN_WINDOWS=15m,4h
UPDOWN_ASSETS=BTC,ETH,SOL,XRP,DOGE,BNB
UPDOWN_MAX_ACTIVE=4
