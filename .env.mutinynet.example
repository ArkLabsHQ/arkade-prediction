# Mutinynet single container (test funds only): UI/API on 37400, unauthenticated operator console/API on 37401
# (protect it at your edge), local 1-of-1 attestor started because ORACLE_SECRET_KEY is set.
# Endpoints, operator/emulator keys, attestor URL and key all default. Read-only check first:
#   node --env-file=.env.mutinynet.example --import tsx scripts/preflight.ts
APM_NETWORK=mutinynet
OPERATOR_MNEMONIC=<12 words: pays genesis of imported markets>
LP_MNEMONIC=<12 different words: posts starting liquidity>
ORACLE_SECRET_KEY=<64 hex chars>
POLYMARKET_ENABLED=true
POLYGON_RPC_URLS=https://polygon.drpc.org,https://polygon.gateway.tenderly.co,https://polygon-bor-rpc.publicnode.com,https://1rpc.io/matic
# Proof tracking for Polymarket mirrors (observation only; settlement still goes through the attestor).
# Polygon reads need archive eth_call (publicnode refuses it); empty keeps the defaults.
ZK_TRACKING_ENABLED=false
POLYGON_ARCHIVE_RPC_URLS=https://polygon.gateway.tenderly.co,https://polygon.drpc.org
ETHEREUM_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
# Then Polymarket's NegRiskAdapter (single outcomes of multi-outcome events). Its crypto Up/Down resolver
# (0x58e1745bedda7312c4cddb72618923da1b90efde) is left out: it reports for whoever calls it, each caller in its own
# questionId namespace, and exposes no view naming a condition's reporter, so nothing on chain authenticates one.
POLYMARKET_RESOLVERS=0x65070BE91477460D8A7AeEb94ef92fe056C2f2A7,0x157Ce2d672854c848c9b79C49a8Cc6cc89176a49,0xd91E80cF2E7be2e162c6513ceD06f1dD0dA35296
# Defaults cover Polymarket's own reporters; set these only to pin a narrower or newer set.
POLYMARKET_CREATORS=
POLYMARKET_NEGRISK_ORACLES=
# Per source. One discovery pass per Polymarket tag fills every board section; the section cap keeps any one from crowding the rest.
IMPORT_MAX_ACTIVE=25
IMPORT_TAGS=sports,crypto,politics,economy,tech,pop-culture,geopolitics
IMPORT_MAX_PER_SECTION=12
IMPORT_INTERVAL_SECONDS=300
# Kalshi (regulated, settled by Kalshi) and Manifold (play money, settled by each market's creator) mirrors via our attestor.
KALSHI_ENABLED=true
MANIFOLD_ENABLED=true
IMPORT_MAX_HORIZON_SECONDS=7776000
MARKET_UNIT_SATS=1000
MARKET_CAP_SETS=100
LP_BOOTSTRAP_SETS=2
LP_ASK_YES_SATS=550
LP_ASK_NO_SATS=550
LP_BUSY_ONLY=true
EXPLORER_URL=https://explorer.mutinynet.arkade.sh
# Polymarket crypto Up/Down mirrors. polymarket: settle on Polymarket's own on-chain result (CTF, via our attestor);
# redstone: settle in-covenant on RedStone's signed rounds. Each mirror costs ~4k sats until it is redeemed.
UPDOWN_ENABLED=true
UPDOWN_SETTLEMENT=redstone
UPDOWN_WINDOWS=1h,4h
UPDOWN_ASSETS=BTC,ETH,SOL,XRP
UPDOWN_MAX_ACTIVE=8
