# Isolated arkade-regtest stack for arkade-prediction.
# Used as: node regtest/regtest.mjs <cmd> --env infra/regtest/stack.env
# Never run `clean --prune` on a shared Docker host: it prunes every dangling volume.
REGTEST_PROJECT=apm-regtest
REGTEST_CONTAINER_PREFIX=apm-
REGTEST_PROFILES=emulator

# Pins (digests resolved 2026-10-07). Emulator matches the public Mutinynet emulator (v0.0.9-rc.1).
ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.16@sha256:f723e26a1bff7fa529dc0abd414088f294e43be8916dbb8f081dccd6fcad90b5
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.16@sha256:9c4092115440039e87f1fc7e053c388d508abb36edbe9fe07c9e0a140948edd2
EMULATOR_IMAGE=ghcr.io/arkade-os/emulator:v0.0.9-rc.1@sha256:56fe9e50e5d8cb1dd7af774c33a61fb6528b7f68af070b87f95c8f09ef2c2444

BITCOIN_RPC_PORT=37443
BITCOIN_P2P_PORT=37444
BITCOIN_ZMQ_BLOCK_PORT=37332
BITCOIN_ZMQ_TX_PORT=37333
NBXPLORER_PORT=37838
POSTGRES_PORT=37372
FULCRUM_TCP_PORT=37001
FULCRUM_WS_PORT=37002
LND_P2P_PORT=37735
LND_RPC_PORT=37009
MEMPOOL_WEB_PORT=37000
MEMPOOL_API_PORT=37999
ARKD_PORT=37070
ARKD_ADMIN_PORT=37071
ARKD_WALLET_PORT=37060
LND_PEER_P2P_PORT=37736
LND_PEER_RPC_PORT=37010
DELEGATOR_GRPC_PORT=37110
DELEGATOR_API_PORT=37111
DELEGATOR_HTTP_PORT=37112
WALLET_PORT=37303
EXPLORER_PORT=37080
EMULATOR_PORT=37073

# Mine explicitly. Seconds-denominated locktimes like Mutinynet: in block mode (< 512) the
# v0.9.16 indexer reports expiresAt = createdAt + N seconds while the sweeper counts N blocks.
# SDK regtest floors: batch expiry >= 6000 s, checkpoint exit delay >= 1200 s.
AUTOMINE_INTERVAL=0
ARKD_VTXO_TREE_EXPIRY=7168
ARKD_UNILATERAL_EXIT_DELAY=512
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=512
ARKD_BOARDING_EXIT_DELAY=1024
ARKD_CHECKPOINT_EXIT_DELAY=1536

# Mirror the Mutinynet operator's advertised intent-fee policy (all zero on 2026-10-07).
ARK_OFFCHAIN_INPUT_FEE=0.0
ARK_ONCHAIN_INPUT_FEE=0.0
ARK_OFFCHAIN_OUTPUT_FEE=0.0
ARK_ONCHAIN_OUTPUT_FEE=0.0
