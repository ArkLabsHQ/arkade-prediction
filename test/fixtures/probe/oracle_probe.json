  "source": {
    "entry": "oracle_probe.ark",
    "files": {
      "oracle_probe.ark": "pragma arkade ^0.1.0;\n\n// Feasibility probe: settle from signatures made by other-chain oracles.\ncontract OracleProbe(bytes evmSigner, bytes p256Signer, int threshold) {\n  // EVM-style oracle: ECDSA/secp256k1 over keccak256(payload); the payload's first 4 bytes carry the value.\n  function evm(bytes payload, signature sig) {\n    bytes msg = digest(payload, 4);\n    require(checkSigFromStack(sig, evmSigner, msg), \"evm sig\");\n    require(bin2num(substr(payload, 0, 4)) >= threshold, \"value\");\n  }\n\n  // HSM / KMS / passkey attestor: ECDSA/P-256 over a SHA-256 digest.\n  function p256(bytes payload, signature sig) {\n    bytes32 h = sha256(payload);\n    require(checkSigFromStack(sig, p256Signer, h), \"p256 sig\");\n  }\n}\n"
    }
  },
