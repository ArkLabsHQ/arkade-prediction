  "source": {
    "entry": "sp1_groth16_nonce.ark",
    "files": {
      "sp1_groth16_nonce.ark": "pragma arkade ^0.1.0;\n\n// Spike: verify an SP1 v6 Groth16 proof (bn254) in Arkade script. base = CONSTANT + programVKey*PUB_0 +\n// vkRoot*PUB_3 is precomputed; exitCode is 0, so its term vanishes. The proof nonce is a witness.\ncontract SP1Groth16Probe(ECPoint alpha, G2Point betaNeg, G2Point gammaNeg, G2Point deltaNeg, ECPoint base, ECPoint pub1, ECPoint pub4) {\n  // digest = sha256(publicValues) with its top 3 bits cleared, given as a witness and checked byte by byte.\n  function verify(ECPoint a, G2Point b, ECPoint c, int nonce, bytes publicValues, int digest, int hi) {\n    bytes32 d = sha256(publicValues);\n    bytes db = reverseBytes(num2bin(digest, 32));\n    require(substr(db, 1, 31) == substr(d, 1, 31), \"digest low bytes\");\n    require(hi >= 0 && hi < 8 && bin2num(substr(db, 0, 1)) < 32, \"digest top bits\");\n    require(bin2num(substr(d, 0, 1) + num2bin(0, 1)) == hi * 32 + bin2num(substr(db, 0, 1) + num2bin(0, 1)), \"digest top byte\");\n    ECPoint m1 = ecMul(pub1, digest, 2);\n    ECPoint m4 = ecMul(pub4, nonce, 2);\n    ECPoint s1 = ecAdd(base, m1, 2);\n    ECPoint vkx = ecAdd(s1, m4, 2);\n    ECPoint[4] g1 = [a, c, alpha, vkx];\n    G2Point[4] g2 = [b, deltaNeg, betaNeg, gammaNeg];\n    require(ecPairing(g1, g2, 2), \"proof\");\n  }\n}\n"
    }
