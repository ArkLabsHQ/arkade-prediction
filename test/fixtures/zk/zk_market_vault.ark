pragma arkade ^0.1.0;

// Spike: market_vault plus resolution by an SP1 Groth16 proof whose 160 public-value bytes are
// zkAnchor ‖ conditionId ‖ denominator ‖ numerator0 ‖ numerator1 (uint256 big-endian each).
// Collateral of an open binary market. Holds the control asset (CTRL) that authorizes YES/NO
// reissuance, so every path pins the YES/NO deltas: spending CTRL alone would allow minting.
contract ZkMarketVault(
  bytes32 ctrlTxid, int ctrlGidx,
  bytes32 yesTxid, int yesGidx,
  bytes32 noTxid, int noGidx,
  int unit,
  int capValue,
  // Attestor keys and quorum; a single-attestor market repeats one key with threshold 1.
  pubkey[3] oracles,
  int threshold,
  bytes32 binding,
  int closeAt,
  int timeoutAt,
  bytes32 resolvedYes,
  bytes32 resolvedNo,
  bytes32 resolvedInvalid,
  // BIP341 NUMS point: arkd needs an exit leaf to admit the vault to batches; nobody can sign it.
  pubkey noExitKey,
  int exit,
  bytes32 zkAnchor,
  bytes32 conditionId,
  ECPoint alpha, G2Point betaNeg, G2Point gammaNeg, G2Point deltaNeg, ECPoint base, ECPoint pub1, ECPoint pub4
) {
  private function sets(int yesDelta, int noDelta) {
    require(tx.assetGroups.has(yesTxid, yesGidx) || yesDelta == 0, "yes group");
    require(!tx.assetGroups.has(yesTxid, yesGidx) || tx.assetGroups.find(yesTxid, yesGidx).delta == yesDelta, "yes delta");
    require(tx.assetGroups.has(noTxid, noGidx) || noDelta == 0, "no group");
    require(!tx.assetGroups.has(noTxid, noGidx) || tx.assetGroups.find(noTxid, noGidx).delta == noDelta, "no delta");
  }

  // An absent attestor passes an empty signature (counts 0); a wrong signature fails the script.
  // Slots are counted, so a quorum above one needs distinct keys or one signer could fill two slots.
  private function attested(bytes32 message, signature[3] oracleSigs) {
    require(threshold == 1 || (oracles[0] != oracles[1] && oracles[0] != oracles[2] && oracles[1] != oracles[2]), "attestor set");
    int valid = 0;
    for (i, sig) in oracleSigs {
      if (checkSigFromStack(sig, oracles[i], message)) {
        valid = valid + 1;
      }
    }
    require(valid >= threshold, "attestation");
  }

  private function keepsCtrl() {
    require(tx.outputs[0].witnessVersion == 1, "vault version");
    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, "ctrl");
    require(tx.outputs[0].assets.length == 1, "vault assets");
  }

  // Locks n * unit sats and mints n YES + n NO.
  function mint(int n) {
    require(n > 0, "n");
    sets(n, n);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, "vault moved");
    require(tx.outputs[0].value == tx.input.current.value + n * unit, "collateral");
    require(tx.outputs[0].value <= capValue, "cap");
  }

  // Burns n YES + n NO and releases n * unit sats.
  function merge(int n) {
    require(n > 0, "n");
    sets(0 - n, 0 - n);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, "vault moved");
    require(tx.outputs[0].value == tx.input.current.value - n * unit, "collateral");
  }

  // One-shot transition to the ResolvedVault committed for the attested vector.
  function resolveYes(bytes32 evidence, signature[3] oracleSigs) {
    require(checkTime(closeAt), "too early");
    bytes32 message = sha256("APM/attest/v1" + binding + evidence + num2bin(1, 8) + num2bin(0, 8) + num2bin(1, 8));
    attested(message, oracleSigs);
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedYes, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  function resolveNo(bytes32 evidence, signature[3] oracleSigs) {
    require(checkTime(closeAt), "too early");
    bytes32 message = sha256("APM/attest/v1" + binding + evidence + num2bin(0, 8) + num2bin(1, 8) + num2bin(1, 8));
    attested(message, oracleSigs);
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedNo, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  function resolveInvalid(bytes32 evidence, signature[3] oracleSigs) {
    require(checkTime(closeAt), "too early");
    bytes32 message = sha256("APM/attest/v1" + binding + evidence + num2bin(1, 8) + num2bin(1, 8) + num2bin(2, 8));
    attested(message, oracleSigs);
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedInvalid, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  // Same check as test/fixtures/zk/sp1_groth16.ark, plus the binding of the public values to this market.
  private function proven(ECPoint a, G2Point b, ECPoint c, int nonce, bytes publicValues, int digest, int hi, int n0, int n1, int den) {
    require(substr(publicValues, 0, 32) == zkAnchor, "anchor");
    require(substr(publicValues, 32, 32) == conditionId, "condition");
    require(substr(publicValues, 64, 32) == reverseBytes(num2bin(den, 32)), "denominator");
    require(substr(publicValues, 96, 32) == reverseBytes(num2bin(n0, 32)), "numerator0");
    require(substr(publicValues, 128, 32) == reverseBytes(num2bin(n1, 32)), "numerator1");
    bytes32 d = sha256(publicValues);
    bytes db = reverseBytes(num2bin(digest, 32));
    require(substr(db, 1, 31) == substr(d, 1, 31), "digest low bytes");
    require(hi >= 0 && hi < 8 && bin2num(substr(db, 0, 1)) < 32, "digest top bits");
    require(bin2num(substr(d, 0, 1) + num2bin(0, 1)) == hi * 32 + bin2num(substr(db, 0, 1) + num2bin(0, 1)), "digest top byte");
    ECPoint m1 = ecMul(pub1, digest, 2);
    ECPoint m4 = ecMul(pub4, nonce, 2);
    ECPoint s1 = ecAdd(base, m1, 2);
    ECPoint vkx = ecAdd(s1, m4, 2);
    ECPoint[4] g1 = [a, c, alpha, vkx];
    G2Point[4] g2 = [b, deltaNeg, betaNeg, gammaNeg];
    require(ecPairing(g1, g2, 2), "proof");
  }

  function resolveZkYes(ECPoint a, G2Point b, ECPoint c, int nonce, bytes publicValues, int digest, int hi) {
    require(checkTime(closeAt), "too early");
    proven(a, b, c, nonce, publicValues, digest, hi, 1, 0, 1);
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedYes, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  function resolveZkNo(ECPoint a, G2Point b, ECPoint c, int nonce, bytes publicValues, int digest, int hi) {
    require(checkTime(closeAt), "too early");
    proven(a, b, c, nonce, publicValues, digest, hi, 0, 1, 1);
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedNo, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  function resolveZkInvalid(ECPoint a, G2Point b, ECPoint c, int nonce, bytes publicValues, int digest, int hi) {
    require(checkTime(closeAt), "too early");
    proven(a, b, c, nonce, publicValues, digest, hi, 1, 1, 2);
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedInvalid, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  // Precommitted fallback when no attestation arrives: split collateral 50/50 per complete set.
  function timeout() {
    require(timeoutAt > 0 && checkTime(timeoutAt), "not timed out");
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedInvalid, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  function renew() {
    require(tx.version == 2, "intent only");
    sets(0, 0);
    require(this.tunnel(this.activeInputIndex - 1), "tunnel");
  }

  function unilateral(signature noExitSig) tapscript {
    require(older(exit));
    require(checkSig(noExitSig, noExitKey));
  }
}
