# All variables accepted by src/server/config.ts (app) and src/oracle/main.ts (attestor).
# Secrets accept NAME_FILE (a mounted file) instead of NAME. Never bake secrets into the image.

# --- identity: changing any of these on an existing volume is refused (drain + migrate instead)
APM_NETWORK=regtest                  # regtest | mutinynet
APM_DEPLOYMENT_ID=apm-local
PUBLIC_BASE_URL=http://localhost:37400
APM_HTTP_PORT=37400                  # host port published by compose.regtest.yaml (local runs only)

# --- Arkade endpoints used by the server, and (optionally) different ones handed to browsers
ARK_SERVER_URL=http://arkd:7070
EMULATOR_URL=http://emulator:7073
ESPLORA_URL=http://mempool_web/api
PUBLIC_ARK_SERVER_URL=
PUBLIC_EMULATOR_URL=
PUBLIC_ESPLORA_URL=
EXPLORER_URL=
# Pins checked against /v1/info at startup (required outside regtest). Covenants commit to EMULATOR_PUBKEY.
ARK_SIGNER_PUBKEY=
EMULATOR_PUBKEY=
ARK_SIGNER_XONLY=                    # attestor: x-only form of ARK_SIGNER_PUBKEY

# --- wallets (separate keys: operator funds genesis and the dev faucet; LP posts liquidity)
OPERATOR_MNEMONIC=
LP_MNEMONIC=
ADMIN_TOKEN=                         # >= 24 chars; protects /api/admin/*
DEV_ORACLE_SECRET=                   # regtest only

# --- oracle / attestor
ORACLE_URL=http://oracle:37410
ORACLE_PUBKEYS=                      # x-only keys the server accepts certificates from
ORACLE_EPOCH=1
ORACLE_SECRET_KEY=                   # attestor process only

# --- source import (Polymarket CTF v1 binary profile)
POLYMARKET_ENABLED=false
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYGON_RPC_URLS=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org
POLYMARKET_RESOLVERS=0x65070BE91477460D8A7AeEb94ef92fe056C2f2A7,0x157Ce2d672854c848c9b79C49a8Cc6cc89176a49
IMPORT_TAGS=
IMPORT_MAX_ACTIVE=5
IMPORT_MIN_HORIZON_SECONDS=3600
IMPORT_MAX_HORIZON_SECONDS=2592000
IMPORT_INTERVAL_SECONDS=600
IMPORT_PAGE_LIMIT=100
IMPORT_MAX_PAGES=5
IMPORT_TIMEOUT_DAYS=60
RESOLUTION_INTERVAL_SECONDS=120

# --- market economics and workers
MARKET_UNIT_SATS=1000
MARKET_BASE_SATS=1000
MARKET_CAP_SETS=1000
KEEPER_INTERVAL_SECONDS=15
RENEW_THRESHOLD_SECONDS=3600
LP_BOOTSTRAP_SETS=0
LP_ASK_YES_SATS=0
LP_ASK_NO_SATS=0
DEV_ENDPOINTS=false
WORKERS=all                          # all | none (API only, no writer)
LOG_LEVEL=info
