  "source": {
    "entry": "sell_offer.ark",
    "files": {
      "sell_offer.ark": "pragma arkade ^0.1.0;\n\n// Standing offer to sell `asset` at `price` sats per unit. The continuation at the offer's own input\n// index keeps the unsold units and accumulates proceeds, so two offers can never share one output.\ncontract SellOffer(\n  pubkey maker,\n  bytes32 makerProgram,\n  bytes32 assetTxid, int assetGidx,\n  int price,\n  int minFill,\n  int expiresAt,\n  int exit\n) {\n  // The fill that sells the last unit pays the maker directly instead of leaving an empty offer.\n  function fill(int qty) {\n    int i = this.activeInputIndex;\n    int remaining = tx.inputs[i].assets.lookup(assetTxid, assetGidx);\n    require(qty > 0 && qty <= remaining, \"qty\");\n    require(qty >= minFill || qty == remaining, \"below min fill\");\n    require(expiresAt == 0 || !checkTime(expiresAt), \"expired\");\n    require(tx.outputs[i].witnessVersion == 1, \"output version\");\n    require(tx.outputs[i].value >= tx.input.current.value + qty * price, \"proceeds\");\n    require(\n      (qty == remaining && tx.outputs[i].scriptPubKey == makerProgram && tx.outputs[i].assets.length == 0) ||\n        (qty < remaining && tx.outputs[i].scriptPubKey == tx.input.current.scriptPubKey &&\n          tx.outputs[i].assets.length == 1 && tx.outputs[i].assets.lookup(assetTxid, assetGidx) == remaining - qty),\n      \"remainder\"\n    );\n  }\n\n  // Anyone may return an expired offer to the maker. No asset opcodes: OP_TUNNEL also covers an asset-free offer.\n  function settle() {\n    int i = this.activeInputIndex;\n    require(expiresAt > 0 && checkTime(expiresAt), \"still live\");\n    require(tx.outputs[i].scriptPubKey == makerProgram, \"maker\");\n    require(tx.outputs[i].witnessVersion == 1, \"maker version\");\n    require(this.tunnel(i, {scriptPubKey: false, value: true, assets: true}), \"settle\");\n  }\n\n  function renew() {\n    require(tx.version == 2, \"intent only\");\n    require(this.tunnel(this.activeInputIndex - 1), \"tunnel\");\n  }\n\n  function cancel(signature makerSig, signature serverSig) tapscript {\n    require(checkMultisig([maker, server], [makerSig, serverSig]));\n  }\n\n  function unilateral(signature makerSig) tapscript {\n    require(older(exit));\n    require(checkSig(makerSig, maker));\n  }\n}\n"
    }
  },
