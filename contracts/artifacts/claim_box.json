  "source": {
    "entry": "claim_box.ark",
    "files": {
      "claim_box.ark": "pragma arkade ^0.1.0;\n\n// Holds one owner's claims for one market so they survive the owner being offline: a keeper may renew\n// the box and, once the market has resolved, redeem it. Redemption burns every claim against a resolved\n// vault (which prices the burn) and must pay everything released, plus the box's sats, to the owner.\ncontract ClaimBox(\n  pubkey owner,\n  bytes32 ownerProgram,\n  bytes32 resolvedYes,\n  bytes32 resolvedNo,\n  bytes32 resolvedInvalid,\n  int exit\n) {\n  function claim() {\n    require(this.activeInputIndex == 1 && tx.numInputs == 2, \"layout\");\n    require(\n      tx.inputs[0].scriptPubKey == resolvedYes || tx.inputs[0].scriptPubKey == resolvedNo || tx.inputs[0].scriptPubKey == resolvedInvalid,\n      \"not a resolved vault of this market\"\n    );\n    require(tx.outputs[1].scriptPubKey == ownerProgram, \"owner\");\n    require(tx.outputs[1].witnessVersion == 1, \"owner version\");\n    require(tx.outputs[1].value >= tx.inputs[0].value - tx.outputs[0].value + tx.input.current.value, \"payout\");\n    require(tx.outputs[1].assets.length == 0, \"claims must be burned\");\n  }\n\n  function renew() {\n    require(tx.version == 2, \"intent only\");\n    require(this.tunnel(this.activeInputIndex - 1), \"tunnel\");\n  }\n\n  function withdraw(signature ownerSig, signature serverSig) tapscript {\n    require(checkMultisig([owner, server], [ownerSig, serverSig]));\n  }\n\n  function unilateral(signature ownerSig) tapscript {\n    require(older(exit));\n    require(checkSig(ownerSig, owner));\n  }\n}\n"
    }
  },
