  "source": {
    "entry": "spike_pay.ark",
    "files": {
      "spike_pay.ark": "pragma arkade ^0.1.0;\n\n// Pipeline probe: anyone may forward the coin to `recipient`, minus at most `maxFee` sats.\ncontract SpikePay(pubkey owner, bytes32 recipient, int maxFee, int exit) {\n  function forward() {\n    require(tx.outputs[0].scriptPubKey == recipient, \"wrong recipient\");\n    require(tx.outputs[0].value + maxFee >= tx.input.current.value, \"fee too high\");\n  }\n\n  function unilateral(signature ownerSig) tapscript {\n    require(older(exit));\n    require(checkSig(ownerSig, owner));\n  }\n}\n"
    }
  },
