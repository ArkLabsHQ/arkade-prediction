  "source": {
    "entry": "resolved_vault.ark",
    "files": {
      "resolved_vault.ark": "pragma arkade ^0.1.0;\n\n// Collateral of a resolved binary market. The payout vector (nYes, nNo) / denom is fixed by the\n// constructor, so every redemption against this vault pays by the same vector.\ncontract ResolvedVault(\n  bytes32 ctrlTxid, int ctrlGidx,\n  bytes32 yesTxid, int yesGidx,\n  bytes32 noTxid, int noGidx,\n  int unit,\n  int nYes, int nNo, int denom,\n  // BIP341 NUMS point: arkd needs an exit leaf to admit the vault to batches; nobody can sign it.\n  pubkey noExitKey,\n  int exit\n) {\n  // Burns claims and releases floor((yesBurn*nYes + noBurn*nNo) * unit / denom) sats.\n  function redeem(int yesBurn, int noBurn) {\n    require(yesBurn >= 0 && noBurn >= 0 && yesBurn + noBurn > 0, \"bad burn\");\n    require(tx.assetGroups.has(yesTxid, yesGidx) || yesBurn == 0, \"yes group\");\n    require(!tx.assetGroups.has(yesTxid, yesGidx) || tx.assetGroups.find(yesTxid, yesGidx).delta == 0 - yesBurn, \"yes delta\");\n    require(tx.assetGroups.has(noTxid, noGidx) || noBurn == 0, \"no group\");\n    require(!tx.assetGroups.has(noTxid, noGidx) || tx.assetGroups.find(noTxid, noGidx).delta == 0 - noBurn, \"no delta\");\n    int payout = (yesBurn * nYes + noBurn * nNo) * unit / denom;\n    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, \"vault moved\");\n    require(tx.outputs[0].witnessVersion == 1, \"vault version\");\n    require(tx.outputs[0].value == tx.input.current.value - payout, \"payout\");\n    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, \"ctrl\");\n    require(tx.outputs[0].assets.length == 1, \"vault assets\");\n  }\n\n  // Batch renewal: the paired intent output keeps script, value and assets.\n  function renew() {\n    require(tx.version == 2, \"intent only\");\n    require(!tx.assetGroups.has(yesTxid, yesGidx) || tx.assetGroups.find(yesTxid, yesGidx).delta == 0, \"yes minted\");\n    require(!tx.assetGroups.has(noTxid, noGidx) || tx.assetGroups.find(noTxid, noGidx).delta == 0, \"no minted\");\n    require(this.tunnel(this.activeInputIndex - 1), \"tunnel\");\n  }\n\n  function unilateral(signature noExitSig) tapscript {\n    require(older(exit));\n    require(checkSig(noExitSig, noExitKey));\n  }\n}\n"
    }
  },
