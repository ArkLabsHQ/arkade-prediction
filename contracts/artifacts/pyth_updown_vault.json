  "source": {
    "entry": "pyth_updown_vault.ark",
    "files": {
      "pyth_updown_vault.ark": "pragma arkade ^0.1.0;\n\n// Collateral of an open binary market. Holds the control asset (CTRL) that authorizes YES/NO\n// reissuance, so every path pins the YES/NO deltas: spending CTRL alone would allow minting.\n// Up/Down market settled by one Pyth Pro (Lazer) signer: YES (Up) when the signed price at the end timestamp is at\n// or above the signed price at the start timestamp. Same collateral and claim mechanics as MarketVault.\ncontract PythUpDownVault(\n  bytes32 ctrlTxid, int ctrlGidx,\n  bytes32 yesTxid, int yesGidx,\n  bytes32 noTxid, int noGidx,\n  int unit,\n  int capValue,\n  int feedId,\n  bytes signer,\n  int startTsUs,\n  int endTsUs,\n  int closeAt,\n  int timeoutAt,\n  bytes32 resolvedYes,\n  bytes32 resolvedNo,\n  bytes32 resolvedInvalid,\n  // BIP341 NUMS point: arkd needs an exit leaf to admit the vault to batches; nobody can sign it.\n  pubkey noExitKey,\n  int exit\n) {\n  private function sets(int yesDelta, int noDelta) {\n    require(tx.assetGroups.has(yesTxid, yesGidx) || yesDelta == 0, \"yes group\");\n    require(!tx.assetGroups.has(yesTxid, yesGidx) || tx.assetGroups.find(yesTxid, yesGidx).delta == yesDelta, \"yes delta\");\n    require(tx.assetGroups.has(noTxid, noGidx) || noDelta == 0, \"no group\");\n    require(!tx.assetGroups.has(noTxid, noGidx) || tx.assetGroups.find(noTxid, noGidx).delta == noDelta, \"no delta\");\n  }\n\n  private function keepsCtrl() {\n    require(tx.outputs[0].witnessVersion == 1, \"vault version\");\n    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, \"ctrl\");\n    require(tx.outputs[0].assets.length == 1, \"vault assets\");\n  }\n\n  // Locks n * unit sats and mints n YES + n NO.\n  function mint(int n) {\n    require(n > 0, \"n\");\n    sets(n, n);\n    keepsCtrl();\n    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, \"vault moved\");\n    require(tx.outputs[0].value == tx.input.current.value + n * unit, \"collateral\");\n    require(tx.outputs[0].value <= capValue, \"cap\");\n  }\n\n  // Burns n YES + n NO and releases n * unit sats.\n  function merge(int n) {\n    require(n > 0, \"n\");\n    sets(0 - n, 0 - n);\n    keepsCtrl();\n    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, \"vault moved\");\n    require(tx.outputs[0].value == tx.input.current.value - n * unit, \"collateral\");\n  }\n\n  // Pyth Pro \"evm\" updates: ECDSA/secp256k1 over keccak256(payload), one signer. Only a single-feed, price-only\n  // payload is accepted, so every field sits at a fixed offset: magic(4) ts_us(8) channel(1) feeds=1(1) feed(4)\n  // props=1(1) prop=0 Price(1) price int64(8), big-endian. The timestamp must equal the committed one exactly.\n  private function update(bytes payload, signature sig, int ts) {\n    require(size(payload) == 28, \"payload shape\");\n    bytes h = digest(payload, 4);\n    require(checkSigFromStack(sig, signer, h), \"pyth signature\");\n    require(bin2num(reverseBytes(substr(payload, 0, 4)) + num2bin(0, 1)) == 2479346549, \"magic\");\n    require(bin2num(reverseBytes(substr(payload, 4, 8))) == ts, \"timestamp\");\n    require(substr(payload, 13, 1) == num2bin(1, 1), \"one feed\");\n    require(bin2num(reverseBytes(substr(payload, 14, 4)) + num2bin(0, 1)) == feedId, \"feed\");\n    require(substr(payload, 18, 2) == num2bin(1, 1) + num2bin(0, 1), \"price only\");\n    require(bin2num(reverseBytes(substr(payload, 20, 8))) > 0, \"price\");\n  }\n\n  function resolveYes(bytes endPayload, signature endSig, bytes startPayload, signature startSig) {\n    require(checkTime(closeAt), \"too early\");\n    update(endPayload, endSig, endTsUs);\n    update(startPayload, startSig, startTsUs);\n    require(bin2num(reverseBytes(substr(endPayload, 20, 8))) >= bin2num(reverseBytes(substr(startPayload, 20, 8))), \"not up\");\n    sets(0, 0);\n    keepsCtrl();\n    require(tx.outputs[0].scriptPubKey == resolvedYes, \"target\");\n    require(tx.outputs[0].value == tx.input.current.value, \"value\");\n  }\n\n  function resolveNo(bytes endPayload, signature endSig, bytes startPayload, signature startSig) {\n    require(checkTime(closeAt), \"too early\");\n    update(endPayload, endSig, endTsUs);\n    update(startPayload, startSig, startTsUs);\n    require(bin2num(reverseBytes(substr(endPayload, 20, 8))) < bin2num(reverseBytes(substr(startPayload, 20, 8))), \"not down\");\n    sets(0, 0);\n    keepsCtrl();\n    require(tx.outputs[0].scriptPubKey == resolvedNo, \"target\");\n    require(tx.outputs[0].value == tx.input.current.value, \"value\");\n  }\n\n  // Precommitted fallback when no attestation arrives: split collateral 50/50 per complete set.\n  function timeout() {\n    require(timeoutAt > 0 && checkTime(timeoutAt), \"not timed out\");\n    sets(0, 0);\n    keepsCtrl();\n    require(tx.outputs[0].scriptPubKey == resolvedInvalid, \"target\");\n    require(tx.outputs[0].value == tx.input.current.value, \"value\");\n  }\n\n  function renew() {\n    require(tx.version == 2, \"intent only\");\n    sets(0, 0);\n    require(this.tunnel(this.activeInputIndex - 1), \"tunnel\");\n  }\n\n  function unilateral(signature noExitSig) tapscript {\n    require(older(exit));\n    require(checkSig(noExitSig, noExitKey));\n  }\n}\n"
    }
  },
