pragma arkade ^0.1.0;

// Collateral of an open binary market. Holds the control asset (CTRL) that authorizes YES/NO
// reissuance, so every path pins the YES/NO deltas: spending CTRL alone would allow minting.
// Up/Down market settled by RedStone's own signatures, with no strike to trust: YES (Up) when the median signed
// price of the end round is at or above that of the start round. Same collateral and claim mechanics as MarketVault.
contract UpDownVault(
  bytes32 ctrlTxid, int ctrlGidx,
  bytes32 yesTxid, int yesGidx,
  bytes32 noTxid, int noGidx,
  int unit,
  int capValue,
  bytes32 feedId,
  int startAtMs,
  int endAtMs,
  bytes[5] signers,
  int quorum,
  int closeAt,
  int timeoutAt,
  bytes32 resolvedYes,
  bytes32 resolvedNo,
  bytes32 resolvedInvalid,
  // BIP341 NUMS point: arkd needs an exit leaf to admit the vault to batches; nobody can sign it.
  pubkey noExitKey,
  int exit
) {
  private function sets(int yesDelta, int noDelta) {
    require(tx.assetGroups.has(yesTxid, yesGidx) || yesDelta == 0, "yes group");
    require(!tx.assetGroups.has(yesTxid, yesGidx) || tx.assetGroups.find(yesTxid, yesGidx).delta == yesDelta, "yes delta");
    require(tx.assetGroups.has(noTxid, noGidx) || noDelta == 0, "no group");
    require(!tx.assetGroups.has(noTxid, noGidx) || tx.assetGroups.find(noTxid, noGidx).delta == noDelta, "no delta");
  }

  private function keepsCtrl() {
    require(tx.outputs[0].witnessVersion == 1, "vault version");
    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, "ctrl");
    require(tx.outputs[0].assets.length == 1, "vault assets");
  }

  // Locks n * unit sats and mints n YES + n NO.
  function mint(int n) {
    require(n > 0, "n");
    sets(n, n);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, "vault moved");
    require(tx.outputs[0].value == tx.input.current.value + n * unit, "collateral");
    require(tx.outputs[0].value <= capValue, "cap");
  }

  // Burns n YES + n NO and releases n * unit sats.
  function merge(int n) {
    require(n > 0, "n");
    sets(0 - n, 0 - n);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, "vault moved");
    require(tx.outputs[0].value == tx.input.current.value - n * unit, "collateral");
  }

  // Each RedStone signer signs its own observation: keccak256(feedId || value(32, BE, x1e8) || timestampMs(6, BE)
  // || 0x00000020 || 0x000001). Requires `quorum` signers of `round` with (price >= x) == ge. Unrolled per slot: a
  // loop counter under each slot's bound message would compile to OP_PUT, which the pinned SDK cannot load.
  private function atLeast(bytes32[5] values, bytes[5] stamps, signature[5] sigs, int round, int x, bool ge) {
    bytes tail = reverseBytes(num2bin(32, 4)) + reverseBytes(num2bin(1, 3));
    bytes m0 = digest(feedId + values[0] + stamps[0] + tail, 4);
    int c0 = 0;
    if (checkSigFromStack(sigs[0], signers[0], m0) && size(stamps[0]) == 6 && substr(values[0], 0, 24) == num2bin(0, 24) && bin2num(reverseBytes(stamps[0])) == round && (bin2num(reverseBytes(substr(values[0], 24, 8))) >= x) == ge) {
      c0 = 1;
    }
    bytes m1 = digest(feedId + values[1] + stamps[1] + tail, 4);
    int c1 = 0;
    if (checkSigFromStack(sigs[1], signers[1], m1) && size(stamps[1]) == 6 && substr(values[1], 0, 24) == num2bin(0, 24) && bin2num(reverseBytes(stamps[1])) == round && (bin2num(reverseBytes(substr(values[1], 24, 8))) >= x) == ge) {
      c1 = 1;
    }
    bytes m2 = digest(feedId + values[2] + stamps[2] + tail, 4);
    int c2 = 0;
    if (checkSigFromStack(sigs[2], signers[2], m2) && size(stamps[2]) == 6 && substr(values[2], 0, 24) == num2bin(0, 24) && bin2num(reverseBytes(stamps[2])) == round && (bin2num(reverseBytes(substr(values[2], 24, 8))) >= x) == ge) {
      c2 = 1;
    }
    bytes m3 = digest(feedId + values[3] + stamps[3] + tail, 4);
    int c3 = 0;
    if (checkSigFromStack(sigs[3], signers[3], m3) && size(stamps[3]) == 6 && substr(values[3], 0, 24) == num2bin(0, 24) && bin2num(reverseBytes(stamps[3])) == round && (bin2num(reverseBytes(substr(values[3], 24, 8))) >= x) == ge) {
      c3 = 1;
    }
    bytes m4 = digest(feedId + values[4] + stamps[4] + tail, 4);
    int c4 = 0;
    if (checkSigFromStack(sigs[4], signers[4], m4) && size(stamps[4]) == 6 && substr(values[4], 0, 24) == num2bin(0, 24) && bin2num(reverseBytes(stamps[4])) == round && (bin2num(reverseBytes(substr(values[4], 24, 8))) >= x) == ge) {
      c4 = 1;
    }
    require(c0 + c1 + c2 + c3 + c4 >= quorum, "quorum");
  }

  // Up: some x with a quorum of end prices >= x and of start prices <= x, i.e. median(end) >= median(start).
  function resolveYes(int x, bytes32[5] endValues, bytes[5] endStamps, signature[5] endSigs, bytes32[5] startValues, bytes[5] startStamps, signature[5] startSigs) {
    require(checkTime(closeAt), "too early");
    atLeast(endValues, endStamps, endSigs, endAtMs, x, true);
    atLeast(startValues, startStamps, startSigs, startAtMs, x + 1, false);
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedYes, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  // Down: some x with a quorum of end prices < x and of start prices >= x, i.e. median(end) < median(start).
  function resolveNo(int x, bytes32[5] endValues, bytes[5] endStamps, signature[5] endSigs, bytes32[5] startValues, bytes[5] startStamps, signature[5] startSigs) {
    require(checkTime(closeAt), "too early");
    atLeast(endValues, endStamps, endSigs, endAtMs, x, false);
    atLeast(startValues, startStamps, startSigs, startAtMs, x, true);
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedNo, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  // Precommitted fallback when no attestation arrives: split collateral 50/50 per complete set.
  function timeout() {
    require(timeoutAt > 0 && checkTime(timeoutAt), "not timed out");
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedInvalid, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  function renew() {
    require(tx.version == 2, "intent only");
    sets(0, 0);
    require(this.tunnel(this.activeInputIndex - 1), "tunnel");
  }

  function unilateral(signature noExitSig) tapscript {
    require(older(exit));
    require(checkSig(noExitSig, noExitKey));
  }
}
