pragma arkade ^0.1.0;

// Collateral of an open binary market. Holds the control asset (CTRL) that authorizes YES/NO
// reissuance, so every path pins the YES/NO deltas: spending CTRL alone would allow minting.
contract MarketVault(
  bytes32 ctrlTxid, int ctrlGidx,
  bytes32 yesTxid, int yesGidx,
  bytes32 noTxid, int noGidx,
  int unit,
  int capValue,
  pubkey oracle,
  bytes32 binding,
  int closeAt,
  int timeoutAt,
  bytes32 resolvedYes,
  bytes32 resolvedNo,
  bytes32 resolvedInvalid
) {
  private function sets(int yesDelta, int noDelta) {
    require(tx.assetGroups.has(yesTxid, yesGidx) || yesDelta == 0, "yes group");
    require(!tx.assetGroups.has(yesTxid, yesGidx) || tx.assetGroups.find(yesTxid, yesGidx).delta == yesDelta, "yes delta");
    require(tx.assetGroups.has(noTxid, noGidx) || noDelta == 0, "no group");
    require(!tx.assetGroups.has(noTxid, noGidx) || tx.assetGroups.find(noTxid, noGidx).delta == noDelta, "no delta");
  }

  private function keepsCtrl() {
    require(tx.outputs[0].witnessVersion == 1, "vault version");
    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, "ctrl");
    require(tx.outputs[0].assets.length == 1, "vault assets");
  }

  // Locks n * unit sats and mints n YES + n NO.
  function mint(int n) {
    require(n > 0, "n");
    sets(n, n);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, "vault moved");
    require(tx.outputs[0].value == tx.input.current.value + n * unit, "collateral");
    require(tx.outputs[0].value <= capValue, "cap");
  }

  // Burns n YES + n NO and releases n * unit sats.
  function merge(int n) {
    require(n > 0, "n");
    sets(0 - n, 0 - n);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, "vault moved");
    require(tx.outputs[0].value == tx.input.current.value - n * unit, "collateral");
  }

  // One-shot transition to the ResolvedVault committed for the attested vector.
  function resolveYes(bytes32 evidence, signature oracleSig) {
    require(checkTime(closeAt), "too early");
    bytes32 message = sha256("APM/attest/v1" + binding + evidence + num2bin(1, 8) + num2bin(0, 8) + num2bin(1, 8));
    require(checkSigFromStack(oracleSig, oracle, message), "attestation");
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedYes, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  function resolveNo(bytes32 evidence, signature oracleSig) {
    require(checkTime(closeAt), "too early");
    bytes32 message = sha256("APM/attest/v1" + binding + evidence + num2bin(0, 8) + num2bin(1, 8) + num2bin(1, 8));
    require(checkSigFromStack(oracleSig, oracle, message), "attestation");
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedNo, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  function resolveInvalid(bytes32 evidence, signature oracleSig) {
    require(checkTime(closeAt), "too early");
    bytes32 message = sha256("APM/attest/v1" + binding + evidence + num2bin(1, 8) + num2bin(1, 8) + num2bin(2, 8));
    require(checkSigFromStack(oracleSig, oracle, message), "attestation");
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedInvalid, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  // Precommitted fallback when no attestation arrives: split collateral 50/50 per complete set.
  function timeout() {
    require(timeoutAt > 0 && checkTime(timeoutAt), "not timed out");
    sets(0, 0);
    keepsCtrl();
    require(tx.outputs[0].scriptPubKey == resolvedInvalid, "target");
    require(tx.outputs[0].value == tx.input.current.value, "value");
  }

  function renew() {
    require(tx.version == 2, "intent only");
    sets(0, 0);
    require(this.tunnel(this.activeInputIndex - 1), "tunnel");
  }
}
