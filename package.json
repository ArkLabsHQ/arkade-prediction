{
  "name": "arkade-prediction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BTC-collateralized prediction markets on Arkade",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "contracts:build": "node contracts/build.mjs",
    "contracts:check": "node contracts/build.mjs --check",
    "web:dev": "vite",
    "web:build": "vite build",
    "build:server": "esbuild src/server/main.ts src/oracle/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist --outbase=src",
    "build": "pnpm run web:build && pnpm run build:server",
    "start": "node dist/server/main.js",
    "start:oracle": "node dist/oracle/main.js"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.4.78",
    "@hono/node-server": "^1.19.17",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@scure/base": "2.0.0",
    "@scure/bip39": "2.0.1",
    "@scure/btc-signer": "2.0.1",
    "eventsource": "^4.1.1",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
